(version 1)

# Preserve the board-wide clearance outside the J2 pair exception below.
(rule "General hole to copper clearance"
  (constraint hole_clearance (min 0.25mm)))

(rule "Protected 12 V input feed minimum copper width"
  (condition "A.NetName == 'VIN_RAW' || A.NetName == 'VIN_FUSED'")
  (constraint track_width (min 0.8mm)))

(rule "Protected solenoid positive output minimum escape width"
  (condition "A.NetName == 'SOL_POS'")
  (constraint track_width (min 0.4mm)))

(rule "Motor phase absolute minimum at QFN escapes"
  (condition "A.NetName == 'X_A1' || A.NetName == 'X_A2' || A.NetName == 'X_B1' || A.NetName == 'X_B2' || A.NetName == 'Y_A1' || A.NetName == 'Y_A2' || A.NetName == 'Y_B1' || A.NetName == 'Y_B2'")
  (constraint track_width (min 0.25mm)))

(rule "USB local fine-pitch escape vias"
  (condition "A.Type == 'Via' && A.insideArea('USB escape and return vias') && (A.NetName == 'USB_OE_N' || A.NetName == 'GND')")
  (constraint via_diameter (min 0.5mm))
  (constraint annular_width (min 0.1mm)))

(rule "USB-C data contact tie vias"
  (condition "A.Type == 'Via' && A.insideArea('USB escape and return vias') && (A.NetName == 'USB_DP_CONN' || A.NetName == 'USB_DM_CONN')")
  (constraint via_diameter (min 0.4mm))
  (constraint annular_width (min 0.050mm)))

# JLC specifies 0.20 mm minimum for via drill to copper clearance.
(rule "USB-C data contact tie hole clearance"
  (condition "A.NetName != B.NetName && (A.NetName == 'USB_DP_CONN' || A.NetName == 'USB_DM_CONN') && (B.NetName == 'USB_DP_CONN' || B.NetName == 'USB_DM_CONN') && ((A.Type == 'Via' && A.insideArea('USB escape and return vias')) || (B.Type == 'Via' && B.insideArea('USB escape and return vias')))")
  (constraint hole_clearance (min 0.21mm)))

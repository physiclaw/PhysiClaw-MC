  (text "PWM FROM HARDWARE INTERLOCK"
    (at 20.32 96.52 0)
    (effects
      (font
        (size 1.524 1.524)
        (bold yes)
      )
      (justify left)
    )
    (uuid "d6a898e8-3678-55c3-bc22-0154153d5f8f")
  )
  (text "J5 pin 1 = switched positive supply. Pin 2 = ground. Rated coil: 12 V / 0.8 A."
    (at 20.32 163.83 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left)
    )
    (uuid "3d3bb0b5-e3c1-5394-bc30-446285df5dd7")
  )
  (text "Q7 pulls the gate low to energize the coil. R33 pulls the gate to the source to switch it off."
    (at 20.32 168.91 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left)
    )
    (uuid "867fae94-58ba-5f37-a3cd-2c2b75fbfa55")
  )
  (text "D4 carries coil current at turn-off. Use a current-limited 12 V supply. J5 has no dedicated current limit."
    (at 20.32 173.99 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left)
    )
    (uuid "7d8156e4-558e-5be1-b87a-6ef25e9b62e6")
  )
